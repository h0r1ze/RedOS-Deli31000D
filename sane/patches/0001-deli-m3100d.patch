diff --git a/src/pantum.h b/src/pantum.h
index 34f3529..4eaa90b 100644
--- a/src/pantum.h
+++ b/src/pantum.h
@@ -15,9 +15,15 @@
 #include <libusb.h>
 #include <sane/sane.h>
 
-/* The scanner lives on interface 1; interface 0 is the printer and belongs
- * to usblp, so it must never be claimed here. */
+/* Where the scanner sits when the configuration descriptor cannot be read.
+ * On a Pantum M6507 it is interface 1 with bulk 0x02/0x82; interface 0 is the
+ * printer and belongs to usblp, so it must never be claimed here.  Rebadged
+ * units of the same family renumber the pair - the Deli M3100D carries the
+ * printer class interface on 1 and the scanner on 0 - so these are only a
+ * fallback, and find_scan_interface() looks the real numbers up. */
 #define PANTUM_INTERFACE 1
+#define PANTUM_EP_OUT 0x02
+#define PANTUM_EP_IN 0x82
 
 #define PANTUM_MAGIC 0x41535001u /* "ASP\x01" */
 #define PANTUM_HEADER_LEN 32
@@ -135,6 +141,9 @@ typedef struct Pantum_Handle
   struct Pantum_Handle *next;
   Pantum_Device *dev;
   libusb_device_handle *usb;
+  int iface;             /* vendor-specific interface claimed for scanning */
+  unsigned char ep_out;  /* its bulk out endpoint */
+  unsigned char ep_in;   /* its bulk in endpoint */
 
   SANE_Option_Descriptor opt[NUM_OPTIONS];
   Option_Value val[NUM_OPTIONS];
