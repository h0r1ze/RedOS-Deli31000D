+/* Locate the scanner: the first vendor-specific interface that has a pair of
+ * bulk endpoints, and those endpoints.  The M6507 answers with interface 1
+ * and 0x02/0x82, which is what the compiled-in fallback says, but rebadged
+ * units of the same family number their interfaces the other way round, so
+ * the descriptor is the only reliable source.  A device that has no such
+ * interface at all is left to the fallback and will simply fail to talk. */
+static void
+find_scan_interface (libusb_device *dev, int *iface, unsigned char *ep_in,
+                     unsigned char *ep_out)
+{
+  struct libusb_config_descriptor *cfg;
+  int i, a, e, rc;
+
+  *iface = PANTUM_INTERFACE;
+  *ep_in = PANTUM_EP_IN;
+  *ep_out = PANTUM_EP_OUT;
+
+  rc = libusb_get_active_config_descriptor (dev, &cfg);
+  if (rc != LIBUSB_SUCCESS)
+    {
+      DBG (1, "config descriptor: %s, assuming interface %d\n",
+           libusb_error_name (rc), *iface);
+      return;
+    }
+
+  for (i = 0; i < cfg->bNumInterfaces; i++)
+    for (a = 0; a < cfg->interface[i].num_altsetting; a++)
+      {
+        const struct libusb_interface_descriptor *id
+            = &cfg->interface[i].altsetting[a];
+        unsigned char in = 0, out = 0;
+
+        if (id->bInterfaceClass != LIBUSB_CLASS_VENDOR_SPEC)
+          continue;
+        for (e = 0; e < id->bNumEndpoints; e++)
+          {
+            const struct libusb_endpoint_descriptor *ep = &id->endpoint[e];
+
+            if ((ep->bmAttributes & LIBUSB_TRANSFER_TYPE_MASK)
+                != LIBUSB_TRANSFER_TYPE_BULK)
+              continue;
+            if (ep->bEndpointAddress & LIBUSB_ENDPOINT_IN)
+              {
+                if (!in)
+                  in = ep->bEndpointAddress;
+              }
+            else if (!out)
+              out = ep->bEndpointAddress;
+          }
+        if (in && out)
+          {
+            *iface = id->bInterfaceNumber;
+            *ep_in = in;
+            *ep_out = out;
+            DBG (2, "scanner on interface %d, endpoints 0x%02x in 0x%02x out\n",
+                 *iface, *ep_in, *ep_out);
+            libusb_free_config_descriptor (cfg);
+            return;
+          }
+      }
+
+  libusb_free_config_descriptor (cfg);
+  DBG (1, "no vendor-specific bulk interface, assuming interface %d\n", *iface);
+}
+
